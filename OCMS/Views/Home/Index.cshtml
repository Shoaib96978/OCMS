                        <img src="https://i.pravatar.cc/80?img=3" alt="Ahmed">
                        <div><div class="name">Ahmed Khan</div><div class="role">Business Owner, Lahore</div></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="stars">★★★★☆</div>
                    <p>"Very professional system. My water supply complaint was resolved within 48 hours. Highly recommended!"</p>
                    <div class="t-author">
                        <img src="https://i.pravatar.cc/80?img=5" alt="Maria">
                        <div><div class="name">Maria Lopez</div><div class="role">Resident, Islamabad</div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══ CTA Banner ════════════════════════════════════════════ -->
<section class="py-5">
    <div class="container">
        <div class="p-5 rounded-4 text-white text-center" style="background:linear-gradient(135deg,#1a56db,#0f172a);">
            <h2 class="fw-800" style="font-family:var(--font-display);">Ready to File Your Complaint?</h2>
            <p class="opacity-75 mb-4">Join thousands of citizens getting their issues resolved fast.</p>
            <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="register.html" class="btn-primary-ocms" style="background:#f97316;border:none;">Get Started Free</a>
                <a href="submit-complaint.html" class="btn-light-ocms">Submit Complaint</a>
            </div>
        </div>
    </div>
</section>


