@{
    ViewData["Title"] = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
    <div class="container">
        <div class="row g-4">

            <!-- Contact Form -->
            <div class="col-lg-7">
                <div class="ocms-card">
                    <div class="card-body-ocms">
                        <h5 class="fw-700 mb-1" style="font-family:var(--font-display);">Send a Message</h5>
                        <p class="text-muted mb-4" style="font-size:.85rem;">We'll get back to you within 24 hours.</p>

                        <form id="contact-form" novalidate>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="ocms-form-group mb-0">
                                        <label class="ocms-label">Full Name <span class="req">*</span></label>
                                        <input type="text" id="c-name" class="ocms-input" placeholder="Your name" required>
                                        <span class="ocms-error-msg"></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="ocms-form-group mb-0">
                                        <label class="ocms-label">Email Address <span class="req">*</span></label>
                                        <input type="email" id="c-email" class="ocms-input" placeholder="you@example.com" required>
                                        <span class="ocms-error-msg"></span>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="ocms-form-group mb-0">
                                        <label class="ocms-label">Phone (optional)</label>
                                        <input type="tel" id="c-phone" class="ocms-input" placeholder="+92 300 000 0000">
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="ocms-form-group mb-0">
                                        <label class="ocms-label">Subject <span class="req">*</span></label>
                                        <select id="c-subject" class="ocms-select" required>
                                            <option value="">— Select Subject —</option>
                                            <option>General Inquiry</option>
                                            <option>Technical Support</option>
                                            <option>Account Issue</option>
                                            <option>Complaint Follow-up</option>
                                            <option>Feedback</option>
                                        </select>
                                        <span class="ocms-error-msg"></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="ocms-form-group mb-0">
                                        <label class="ocms-label">Message <span class="req">*</span></label>
                                        <textarea id="c-message" class="ocms-textarea" rows="6" placeholder="Describe your question or issue..." required></textarea>
                                        <span class="ocms-error-msg"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-4">
                                <button type="submit" id="contact-btn" class="btn-primary-ocms">
                                    <i class="bi bi-send-fill"></i> Send Message
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Contact Info -->
            <div class="col-lg-5">
                <div class="ocms-card mb-3">
                    <div class="card-body-ocms">
                        <h6 class="fw-700 mb-4" style="font-size:.95rem;"><i class="bi bi-geo-alt me-2 text-primary"></i>Contact Information</h6>

                        <div class="contact-info-item">
                            <div class="ci-icon"><i class="bi bi-geo-alt-fill"></i></div>
                            <div class="ci-text">
                                <div class="label">Office Address</div>
                                <div class="val">123 OCMS Street, Rawalpindi, Punjab, Pakistan</div>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <div class="ci-icon"><i class="bi bi-envelope-fill"></i></div>
                            <div class="ci-text">
                                <div class="label">Email</div>
                                <div class="val"><a href="mailto:support@ocms.com" style="color:var(--primary);">support@ocms.com</a></div>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <div class="ci-icon"><i class="bi bi-telephone-fill"></i></div>
                            <div class="ci-text">
                                <div class="label">Phone</div>
                                <div class="val">+92 300 123 4567</div>
                            </div>
                        </div>
                        <div class="contact-info-item mb-0">
                            <div class="ci-icon"><i class="bi bi-clock-fill"></i></div>
                            <div class="ci-text">
                                <div class="label">Support Hours</div>
                                <div class="val">Mon–Fri: 9:00 AM – 6:00 PM</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FAQ -->
                <div class="ocms-card">
                    <div class="card-body-ocms">
                        <h6 class="fw-700 mb-3" style="font-size:.9rem;"><i class="bi bi-question-circle me-2 text-warning"></i>Quick FAQ</h6>
                        <div class="accordion accordion-flush" id="faq">
                            <div class="accordion-item border-0 border-bottom">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed px-0" style="font-size:.84rem;font-weight:600;" data-bs-toggle="collapse" data-bs-target="#f1">
                                        How do I track my complaint?
                                    </button>
                                </h2>
                                <div id="f1" class="accordion-collapse collapse" data-bs-parent="#faq">
                                    <div class="accordion-body px-0 pt-0 text-muted" style="font-size:.82rem;">Use the Track Complaint page and enter your Complaint ID sent to your email.</div>
                                </div>
                            </div>
                            <div class="accordion-item border-0 border-bottom">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed px-0" style="font-size:.84rem;font-weight:600;" data-bs-toggle="collapse" data-bs-target="#f2">
                                        How long does resolution take?
                                    </button>
                                </h2>
                                <div id="f2" class="accordion-collapse collapse" data-bs-parent="#faq">
                                    <div class="accordion-body px-0 pt-0 text-muted" style="font-size:.82rem;">Typically 24–72 hours depending on the category and severity of the complaint.</div>
                                </div>
                            </div>
                            <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed px-0" style="font-size:.84rem;font-weight:600;" data-bs-toggle="collapse" data-bs-target="#f3">
                                        Can I submit anonymously?
                                    </button>
                                </h2>
                                <div id="f3" class="accordion-collapse collapse" data-bs-parent="#faq">
                                    <div class="accordion-body px-0 pt-0 text-muted" style="font-size:.82rem;">Anonymous submissions are supported for certain categories. Your identity is protected by default.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <script>
          
        $(document).ready(function () {

            $('#contact-form').on('submit', function (e) {
                e.preventDefault();

                if (!validateContactForm()) return;

                const data = {
                    Name: $('#c-name').val().trim(),
                    Email: $('#c-email').val().trim(),
                    Phone: $('#c-phone').val().trim(),
                    Subject: $('#c-subject').val(),
                    Message: $('#c-message').val().trim()
                };

                OCMS.ajaxPost('/Contact/Send', data, document.getElementById('contact-btn'), function (response) {
                    $('#contact-form')[0].reset();
                    clearContactErrors();
                });
            });

            // Live clear error on input
            $('#c-name, #c-email, #c-phone, #c-subject, #c-message').on('input change', function () {
                $(this).removeClass('is-invalid');
                $(this).siblings('.ocms-error-msg').text('');
            });
        });

        // =========================
        // Validation
        // =========================
                function validateContactForm() {
            let valid = true;
            clearContactErrors();

            const name = $('#c-name').val().trim();
            if (!name) {
                showFieldError('#c-name', 'Full name is required.');
                valid = false;
            }

            const email = $('#c-email').val().trim();
            const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!email) {
                showFieldError('#c-email', 'Email address is required.');
                valid = false;
            } else if (!emailPattern.test(email)) {
                showFieldError('#c-email', 'Enter a valid email address.');
                valid = false;
            }

            // ...baaki same rahega
        }

        function showFieldError(selector, message) {
            $(selector).addClass('is-invalid');
            $(selector).siblings('.ocms-error-msg').text(message);
        }

        function clearContactErrors() {
            $('#contact-form .is-invalid').removeClass('is-invalid');
            $('#contact-form .ocms-error-msg').text('');
        }
 
    </script>
}

                              