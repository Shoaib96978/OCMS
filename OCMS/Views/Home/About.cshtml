
@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Mission -->
<section class="py-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="section-label"><i class="bi bi-bullseye"></i> Our Mission</div>
                <h2 class="section-title">Making Every Voice Heard</h2>
                <p class="section-sub">OCMS was built to bridge the gap between citizens and authorities by providing a digital platform for efficient, transparent complaint resolution.</p>
                <div class="d-flex flex-column gap-3 mt-4">
                    <div class="d-flex gap-3 align-items-start">
                        <div style="width:36px;height:36px;background:var(--primary-light);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi bi-check2 text-primary"></i>
                        </div>
                        <div>
                            <p class="fw-600 mb-1" style="font-size:.9rem;">Transparent Process</p>
                            <p class="text-muted mb-0" style="font-size:.84rem;">Every step of the complaint lifecycle is visible to the user.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3 align-items-start">
                        <div style="width:36px;height:36px;background:var(--primary-light);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi bi-lightning text-primary"></i>
                        </div>
                        <div>
                            <p class="fw-600 mb-1" style="font-size:.9rem;">Fast Resolution</p>
                            <p class="text-muted mb-0" style="font-size:.84rem;">Complaints are routed directly to responsible departments.</p>
                        </div>
                    </div>
                    <div class="d-flex gap-3 align-items-start">
                        <div style="width:36px;height:36px;background:var(--primary-light);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <i class="bi bi-shield-lock text-primary"></i>
                        </div>
                        <div>
                            <p class="fw-600 mb-1" style="font-size:.9rem;">Data Privacy</p>
                            <p class="text-muted mb-0" style="font-size:.84rem;">Your personal data is encrypted and never shared without consent.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="p-4 rounded-4" style="background:linear-gradient(135deg,#1a56db,#0f172a);color:#fff;">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background:rgba(255,255,255,.1);">
                                <div class="fw-800 fs-3" style="font-family:var(--font-display);">500+</div>
                                <div class="opacity-75" style="font-size:.82rem;">Complaints Resolved</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background:rgba(255,255,255,.1);">
                                <div class="fw-800 fs-3" style="font-family:var(--font-display);">1,200+</div>
                                <div class="opacity-75" style="font-size:.82rem;">Active Users</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background:rgba(255,255,255,.1);">
                                <div class="fw-800 fs-3" style="font-family:var(--font-display);">98%</div>
                                <div class="opacity-75" style="font-size:.82rem;">Satisfaction Rate</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded-3" style="background:rgba(255,255,255,.1);">
                                <div class="fw-800 fs-3" style="font-family:var(--font-display);">24h</div>
                                <div class="opacity-75" style="font-size:.82rem;">Avg Response</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Values -->
<section class="py-5" style="background:#f8fafc;">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label mx-auto"><i class="bi bi-gem"></i> Our Values</div>
            <div class="section-title">What We Stand For</div>
        </div>
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="about-value-card">
                    <div class="av-icon"><i class="bi bi-eye"></i></div>
                    <h6 class="fw-700 mb-2">Transparency</h6>
                    <p class="text-muted mb-0" style="font-size:.84rem;">Open, honest processes that citizens can follow end-to-end.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="about-value-card">
                    <div class="av-icon"><i class="bi bi-person-heart"></i></div>
                    <h6 class="fw-700 mb-2">Accountability</h6>
                    <p class="text-muted mb-0" style="font-size:.84rem;">Departments are held responsible for timely resolutions.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="about-value-card">
                    <div class="av-icon"><i class="bi bi-shield-check"></i></div>
                    <h6 class="fw-700 mb-2">Integrity</h6>
                    <p class="text-muted mb-0" style="font-size:.84rem;">Every complaint is treated fairly and impartially.</p>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="about-value-card">
                    <div class="av-icon"><i class="bi bi-rocket"></i></div>
                    <h6 class="fw-700 mb-2">Efficiency</h6>
                    <p class="text-muted mb-0" style="font-size:.84rem;">Smart routing ensures the fastest possible resolution times.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-label mx-auto"><i class="bi bi-chat-quote"></i> Testimonials</div>
            <div class="section-title">What Citizens Say</div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p>"OCMS made it incredibly easy to file my complaint. The process was smooth and I got a resolution within days!"</p>
                    <div class="t-author"><img src="https://i.pravatar.cc/80?img=1" alt="Sarah"><div><div class="name">Sarah Johnson</div><div class="role">Citizen, Karachi</div></div></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="stars">★★★★★</div>
                    <p>"I could track my issue in real-time. It felt reassuring to be updated at every step of the process."</p>
                    <div class="t-author"><img src="https://i.pravatar.cc/80?img=3" alt="Ahmed"><div><div class="name">Ahmed Khan</div><div class="role">Business Owner, Lahore</div></div></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div class="stars">★★★★☆</div>
                    <p>"Very professional system. My complaint was resolved within 48 hours. Highly recommended!"</p>
                    <div class="t-author"><img src="https://i.pravatar.cc/80?img=5" alt="Maria"><div><div class="name">Maria Lopez</div><div class="role">Resident, Islamabad</div></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

