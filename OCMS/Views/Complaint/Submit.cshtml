@{
    ViewData["Title"] = "Submit Complaint";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">

        <!-- Steps indicator -->
        <div class="d-flex align-items-center gap-0 mb-4" id="step-indicator">
          <div class="d-flex flex-column align-items-center" style="flex:1;">
            <div class="step-dot active" id="dot-1">1</div>
            <small class="mt-1 fw-600" style="font-size:.75rem;color:var(--primary);">Details</small>
          </div>
          <div class="step-line"></div>
          <div class="d-flex flex-column align-items-center" style="flex:1;">
            <div class="step-dot" id="dot-2">2</div>
            <small class="mt-1" style="font-size:.75rem;color:var(--text-muted);">Description</small>
          </div>
          <div class="step-line"></div>
          <div class="d-flex flex-column align-items-center" style="flex:1;">
            <div class="step-dot" id="dot-3">3</div>
            <small class="mt-1" style="font-size:.75rem;color:var(--text-muted);">Attachments</small>
          </div>
        </div>

        <style>
          .step-dot {
            width: 36px; height: 36px; border-radius: 50%;
            background: var(--border); color: var(--text-muted);
            display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: .85rem; transition: all .3s;
          }
          .step-dot.active { background: var(--primary); color: #fff; }
          .step-dot.done   { background: var(--success);  color: #fff; }
          .step-line { flex:1; height:2px; background:var(--border); }
        </style>

        <div class="ocms-card">
          <div class="card-body-ocms">
            <form id="complaint-form" enctype="multipart/form-data" novalidate>

              <!-- Step 1 -->
              <div id="step-1">
                <h6 class="fw-700 mb-4" style="font-size:1rem;">
                  <i class="bi bi-info-circle me-2 text-primary"></i>Basic Information
                </h6>
                <div class="ocms-form-group">
                  <label class="ocms-label">Complaint Title <span class="req">*</span></label>
                  <input type="text" id="title" class="ocms-input" placeholder="e.g. Water supply interrupted for 3 days" required>
                  <span class="ocms-error-msg"></span>
                </div>
                <div class="row g-3">
                  <div class="col-sm-6">
                    <div class="ocms-form-group mb-0">
                      <label class="ocms-label">Category <span class="req">*</span></label>
                      <select id="category" class="ocms-select" required>
                        <option value="">— Select Category —</option>
                        @* <option value="service">Service</option>
                        <option value="technical">Technical</option>
                        <option value="billing">Billing</option>
                        <option value="infrastructure">Infrastructure</option>
                        <option value="sanitation">Sanitation</option>
                        <option value="other">Other</option> *@
                      </select>
                      <span class="ocms-error-msg"></span>
                    </div>
                  </div>
                  <div class="col-sm-6">
                    <div class="ocms-form-group mb-0">
                      <label class="ocms-label">Priority</label>
                      <select id="priority" class="ocms-select">
                        <option value="normal">Normal</option>
                        <option value="urgent">Urgent</option>
                        <option value="low">Low</option>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="ocms-form-group mt-3">
                  <label class="ocms-label">Location (optional)</label>
                  <div class="position-relative">
                    <i class="bi bi-geo-alt" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:.9rem;"></i>
                    <input type="text" id="location" class="ocms-input" style="padding-left:38px;" placeholder="Street, Area, City">
                  </div>
                </div>
                <div class="d-flex justify-content-end mt-2">
                  <button type="button" id="next-1" class="btn-primary-ocms">
                    Next <i class="bi bi-arrow-right"></i>
                  </button>
                </div>
              </div>

              <!-- Step 2 -->
              <div id="step-2" class="d-none">
                <h6 class="fw-700 mb-4" style="font-size:1rem;">
                  <i class="bi bi-pencil me-2 text-primary"></i>Describe Your Complaint
                </h6>
                <div class="ocms-form-group">
                  <label class="ocms-label">Detailed Description <span class="req">*</span></label>
                  <textarea id="description" class="ocms-textarea" rows="7"
                    placeholder="Describe your issue in detail — when it started, what happened, how it affects you..." required></textarea>
                  <div class="d-flex justify-content-between mt-1">
                    <span class="ocms-error-msg"></span>
                    <small id="char-count" style="font-size:.75rem;color:var(--text-muted);">0 / 1000</small>
                  </div>
                </div>
                <div class="d-flex justify-content-between mt-2">
                  <button type="button" id="back-2" class="btn-outline-ocms">
                    <i class="bi bi-arrow-left"></i> Back
                  </button>
                  <button type="button" id="next-2" class="btn-primary-ocms">
                    Next <i class="bi bi-arrow-right"></i>
                  </button>
                </div>
              </div>

              <!-- Step 3 -->
              <div id="step-3" class="d-none">
                <h6 class="fw-700 mb-4" style="font-size:1rem;">
                  <i class="bi bi-paperclip me-2 text-primary"></i>Attachments (Optional)
                </h6>

                <div id="drop-zone" class="text-center py-4 px-3 rounded-3 mb-3"
                  style="border:2px dashed var(--border);cursor:pointer;transition:border-color .2s;">
                  <i class="bi bi-cloud-upload fs-1 text-muted mb-2 d-block"></i>
                  <p class="mb-1" style="font-size:.9rem;color:var(--text-muted);">Drag &amp; drop files here</p>
                  <p class="mb-2" style="font-size:.78rem;color:var(--text-light);">PNG, JPG, PDF — max 5MB each</p>
                  <label for="attachments" class="btn-outline-ocms" style="cursor:pointer;font-size:.82rem;padding:7px 18px;">
                    Browse Files
                  </label>
                  <input type="file" id="attachments" name="attachments" multiple accept="image/*,.pdf" class="d-none">
                </div>
                <div id="file-preview" class="d-flex flex-wrap gap-2 mb-3"></div>

                <div class="p-3 rounded-3 mb-4" style="background:#f0fdf4;border:1px solid #bbf7d0;">
                  <div class="d-flex gap-2 align-items-start">
                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                    <div>
                      <p class="mb-0" style="font-size:.84rem;color:#166534;font-weight:600;">Your complaint is anonymous-safe</p>
                      <p class="mb-0" style="font-size:.78rem;color:#15803d;">Only authorized staff will see personal details.</p>
                    </div>
                  </div>
                </div>

                <div class="d-flex justify-content-between mt-2">
                  <button type="button" id="back-3" class="btn-outline-ocms">
                    <i class="bi bi-arrow-left"></i> Back
                  </button>
                  <button type="submit" id="submit-btn" class="btn-primary-ocms">
                    <i class="bi bi-send-fill"></i> Submit Complaint
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="col-lg-4 mt-4 mt-lg-0">
        <div class="ocms-card mb-3">
          <div class="card-body-ocms">
            <h6 class="fw-700 mb-3" style="font-size:.9rem;"><i class="bi bi-lightbulb me-2 text-warning"></i>Tips for a Good Complaint</h6>
            <ul class="d-flex flex-column gap-2 mb-0" style="font-size:.82rem;color:var(--text-muted);">
              <li class="d-flex gap-2"><i class="bi bi-check2 text-success mt-1"></i> Be specific about dates and locations</li>
              <li class="d-flex gap-2"><i class="bi bi-check2 text-success mt-1"></i> Include photos or documents if possible</li>
              <li class="d-flex gap-2"><i class="bi bi-check2 text-success mt-1"></i> Describe how it affects you</li>
              <li class="d-flex gap-2"><i class="bi bi-check2 text-success mt-1"></i> Keep your contact info updated</li>
            </ul>
          </div>
        </div>
        <div class="ocms-card">
          <div class="card-body-ocms">
            <h6 class="fw-700 mb-3" style="font-size:.9rem;"><i class="bi bi-clock-history me-2 text-primary"></i>Resolution Times</h6>
            <div class="d-flex flex-column gap-2" style="font-size:.82rem;">
              <div class="d-flex justify-content-between">
                <span class="text-muted">Service</span>
                <span class="fw-600">24–48 hours</span>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Technical</span>
                <span class="fw-600">2–3 days</span>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Infrastructure</span>
                <span class="fw-600">5–7 days</span>
              </div>
              <div class="d-flex justify-content-between">
                <span class="text-muted">Billing</span>
                <span class="fw-600">3–5 days</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

@section Scripts {

    <script>
        $(document).ready(function () {
            LoadCategories();

            // Step Navigation
            $('#next-1').click(function () {
                if (validateStep1()) showStep(2);
            });

            $('#next-2').click(function () {
                if (validateStep2()) showStep(3);
            });

            $('#back-2').click(() => showStep(1));
            $('#back-3').click(() => showStep(2));

            // Character Counter
            $('#description').on('input', function () {
                $('#char-count').text($(this).val().length + ' / 1000');
            });

            // File Preview
            $('#attachments').on('change', function () {
                previewFiles(this.files);
            });

            // Submit Form
            $('#complaint-form').submit(function (e) {
                e.preventDefault();
                SubmitComplaint(e, document.getElementById('submit-btn'));
            });
        });

        // =========================
        // Load Categories
        // =========================
        function LoadCategories() {
            $.ajax({
                url: '/Category/GetAll',
                type: 'GET',
                success: function (response) {
                    if (!response.success) return;

                    const select = $('#category');
                    select.empty();
                    select.append(`<option value="">— Select Category —</option>`);

                    response.data.forEach(c => {
                        select.append(
                            `<option value="${c.categoryId}">${c.categoryName}</option>`
                        );
                    });
                }
            });
        }

        // =========================
        // Step Handling
        // =========================
        function showStep(step) {
            $('#step-1, #step-2, #step-3').addClass('d-none');
            $('#step-' + step).removeClass('d-none');

            $('.step-dot').removeClass('active done');

            for (let i = 1; i <= 3; i++) {
                if (i < step) {
                    $('#dot-' + i).addClass('done');
                } else if (i === step) {
                    $('#dot-' + i).addClass('active');
                }
            }
        }

        // =========================
        // Step 1 Validation
        // =========================
        function validateStep1() {
            let valid = true;

            if (!$('#title').val().trim()) {
                $('#title').addClass('is-invalid');
                valid = false;
            } else {
                $('#title').removeClass('is-invalid');
            }

            if (!$('#category').val()) {
                $('#category').addClass('is-invalid');
                valid = false;
            } else {
                $('#category').removeClass('is-invalid');
            }

            return valid;
        }

        // =========================
        // Step 2 Validation
        // =========================
        function validateStep2() {
            let valid = true;

            if (!$('#description').val().trim()) {
                $('#description').addClass('is-invalid');
                valid = false;
            } else {
                $('#description').removeClass('is-invalid');
            }

            return valid;
        }

        // =========================
        // File Preview
        // =========================
        function previewFiles(files) {
            const preview = $('#file-preview');
            preview.html('');

            Array.from(files).forEach(file => {
                if (file.type.startsWith('image/')) {
                    const reader = new FileReader();

                    reader.onload = function (e) {
                        preview.append(`
                            <div class="border rounded p-2">
                                <img src="${e.target.result}" width="80" height="80" style="object-fit:cover;">
                            </div>
                        `);
                    };

                    reader.readAsDataURL(file);
                }
            });
        }

        // =========================
        // Submit Complaint Using Your Helper
        // =========================
        function SubmitComplaint(event, btn) {
            const formData = new FormData();

            formData.append("Title", $('#title').val());
            formData.append("CategoryId", $('#category').val());
            formData.append("Description", $('#description').val());
            formData.append("Priority", $('#priority').val());
            formData.append("Location", $('#location').val());

            const files = $('#attachments')[0].files;

            for (let i = 0; i < files.length; i++) {
                formData.append("ImageFile", files[i]);
            }

            OCMS.ajaxPostForm('/Complaint/Submit', formData, btn, function (response) {

                // Success callback
                if (response.data && response.data.trackId) {
                    OCMS.showToast('Complaint Submitted | Track ID: ' + response.data.trackId, 'success');
                }

                $('#complaint-form')[0].reset();
                $('#file-preview').html('');
                $('#char-count').text('0 / 1000');

                showStep(1);
            });
        }
    </script>

