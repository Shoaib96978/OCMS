
@{
    ViewData["Title"] = "VerifyEmailPage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Email Verification Section -->
<section class="verify-email-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-card">
                    <div class="login-header">
                        <h2>Email Verification</h2>
                        <p>Please enter your email to verify</p>
                    </div>

                    <form id="verifyEmailForm" class="login-form">
                        <div class="form-group">
                            <label for="verifyEmail">Email</label>
                            <input type="email" id="verifyEmail" name="Email" required placeholder="Enter your email" />
                        </div>

                        <button type="submit" class="login-btn">Verify Email</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
