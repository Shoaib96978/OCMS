
@{
    ViewData["Title"] = "ResetPasswordPage";
    Layout = "~/Areas/User/Shared/_Layout.cshtml";
}

<!-- Update Password Section -->
<section class="update-password-section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-card">
                    <div class="login-header">
                        <h2>Update Password</h2>
                        <p>Please enter OTP and your new password</p>
                    </div>

                    <form id="updatePasswordForm" class="login-form">
                        <input type="hidden" name="UserId" value="@TempData["userId"]" />
                        <!-- OTP Field -->
                        <div class="form-group">
                            <label for="otp">Enter OTP</label>
                            <input type="text" id="otp" name="Otp" required placeholder="Enter OTP code">
                        </div>

                        <!-- New Password -->
                        <div class="form-group">
                            <label for="newPassword">New Password</label>
                            <input type="password" id="newPassword" name="Password" required placeholder="Enter new password">
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group">
                            <label for="confirmPassword">Confirm Password</label>
                            <input type="password" id="confirmPassword" name="NewPassword" required placeholder="Confirm new password">
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" onclick="UpdatePassword(event)" class="login-btn">Update Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

