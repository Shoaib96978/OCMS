@functions {
    public string IsActive(string controllerName, string actionName)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        return (currentController == controllerName && currentAction == actionName) ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard – OCMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/assets/css/admin.css" rel="stylesheet">
    <link href="/assets/css/StyleSheet.css" rel="stylesheet">
</head>
<body>

    <div id="app-loader"><div class="loader-brand">OCMS Admin</div><div class="loader-ring"></div></div>
    <div id="toast-container"></div>

    <div id="confirm-modal-backdrop">
        <div class="confirm-modal-box">
            <div class="modal-icon">⚠️</div><div class="modal-title">Are you sure?</div>
            <div class="modal-text">This action cannot be undone.</div>
            <div class="modal-actions">
                <button id="confirm-cancel-btn" class="btn btn-outline-secondary btn-sm px-4">Cancel</button>
                <button id="confirm-ok-btn" class="btn btn-danger btn-sm px-4">Confirm</button>
            </div>
        </div>
    </div>

    <div id="admin-wrapper">

        <!-- ═══ SIDEBAR ════════════════════════════════════════════ -->
        <aside id="admin-sidebar">
            <div class="sidebar-logo">
                <i class="bi bi-shield-check text-primary fs-5"></i>
                <span class="logo-text">OCMS Admin</span>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-label">Main</div>

                <a class="sidebar-link @IsActive("Admin", "Index")" href="@Url.Action("Index", "Admin")" data-href="dashboard">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span class="link-text">Dashboard</span>
                </a>
                <a class="sidebar-link @IsActive("Admin", "Complaints")" href="@Url.Action("Complaints", "Admin")" data-href="complaints">
                    <i class="bi bi-clipboard2-list"></i>
                    <span class="link-text">Complaints</span>
                    <span class="sidebar-badge" id="pending-count-badge">—</span>
                </a>
                <a class="sidebar-link @IsActive("Admin", "Users")" href="@Url.Action("Users", "Admin")" data-href="users">
                    <i class="bi bi-people"></i>
                    <span class="link-text">Users</span>
                </a>

                <div class="nav-section-label">System</div>
                <a class="sidebar-link" href="/Auth/LogOut" id="admin-logout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="link-text">Sign Out</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    @if (User.FindFirst("ImageLink") == null || string.IsNullOrEmpty(User.FindFirst("ImageLink")!.Value))
                    {
                        <div style="width:36px;height:36px;border-radius:50%;background:var(--primary-light);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:700;">@User.Identity!.Name!.FirstOrDefault()</div>
                    }
                    else
                    {
                        <img src="@User.FindFirst("ImageLink")!.Value" alt="Admin">
                    }
                    <div class="user-info">
                        <div class="user-name">@User.Identity!.Name</div>
                        <div class="user-role">Administrator</div>
                    </div>
                </div>
            </div>
        </aside>

        <div id="admin-main">

            <!-- Top Bar -->
            <header id="admin-topbar">
                <button id="sidebar-toggle" class="toggle-btn"><i class="bi bi-list"></i></button>

                <div class="topbar-search">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Search complaints, users…" id="table-search">
                </div>

                <div class="topbar-actions">
                    <button class="topbar-icon-btn">
                        <i class="bi bi-bell"></i>
                        <span class="badge-dot"></span>
                    </button>
                    <button class="topbar-icon-btn"><i class="bi bi-envelope"></i></button>
                    <div class="topbar-divider"></div>

                    <div class="dropdown">
                        <div class="topbar-avatar" data-bs-toggle="dropdown" style="cursor:pointer;">
                            @if (User.FindFirst("ImageLink") == null || string.IsNullOrEmpty(User.FindFirst("ImageLink")!.Value))
                            {
                                <div style="width:34px;height:34px;border-radius:50%;background:var(--primary-light);color:var(--primary);display:flex;align-items:center;justify-content:center;font-weight:700;">@User.Identity!.Name!.FirstOrDefault()</div>
                            }
                            else
                            {
                                <img src="@User.FindFirst("ImageLink")!.Value" alt="Admin">
                            }
                            <div>
                                <div class="av-name">@User.Identity!.Name</div>
                                <div class="av-role">Administrator</div>
                            </div>
                            <i class="bi bi-chevron-down ms-1" style="font-size:.7rem;color:var(--text-muted);"></i>
                        </div>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="border-radius:var(--radius);font-size:.84rem;">
                            <li><a class="dropdown-item text-danger" href="/Auth/LogOut"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main id="admin-content">
                @RenderBody()
            </main>
        </div>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="/assets/js/jquery.min.js"></script>
    <!-- Admin Helper -->
    <script src="/assets/js/adminHelper.js"></script>
    <script src="/assets/js/app.js"></script>

    @RenderSection("ChartScripts", required: false)

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>