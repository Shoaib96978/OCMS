@functions {
    public string IsActive(string controllerName, string actionName)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        return (currentController == controllerName && currentAction == actionName) ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OCMS – Online Complaint Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/css/StyleSheet.css">
</head>
<body>
    <!-- ═══ App Loader ═══════════════════════════════════════════ -->
    <div id="app-loader">
        <div class="loader-brand">OCMS</div>
        <div class="loader-ring"></div>
    </div>

    <!-- ═══ Toast Container ══════════════════════════════════════ -->
    <div id="toast-container"></div>

    <!-- ═══ Confirm Modal ════════════════════════════════════════ -->
    <div id="confirm-modal-backdrop">
        <div class="confirm-modal-box">
            <div class="modal-icon">⚠️</div>
            <div class="modal-title">Are you sure?</div>
            <div class="modal-text">This action cannot be undone.</div>
            <div class="modal-actions">
                <button id="confirm-cancel-btn" class="btn btn-outline-secondary btn-sm px-4">Cancel</button>
                <button id="confirm-ok-btn" class="btn btn-danger btn-sm px-4">Confirm</button>
            </div>
        </div>
    </div>

    <!-- ═══ Navbar ════════════════════════════════════════════════ -->
    <nav class="ocms-navbar">
        <div class="container d-flex align-items-center gap-3">
            <a href="/Home/Index" class="navbar-brand me-auto">
                <i class="bi bi-shield-check"></i>
                OCMS
            </a>

            @if (User.Identity!.IsAuthenticated)
            {
                <!-- Desktop Nav -->
                <div class="d-none d-lg-flex align-items-center gap-1">
                    <a href="/Home/Index" class="nav-link @IsActive("Home", "Index")">Home</a>
                    <a href="/Complaint/Submit" class="nav-link @IsActive("Complaint", "Submit")">Submit</a>
                    <a href="/Complaint/Track" class="nav-link @IsActive("Complaint", "Track")">Track</a>
                </div>
                <div class="d-none d-lg-flex align-items-center gap-2 ms-3">
                    <div class="dropdown">
                        <button class="btn d-flex align-items-center gap-2 border-0 p-0" data-bs-toggle="dropdown">
                            @if (User.FindFirst("ImageLink") == null)
                            {
                                <div style="width:34px;height:34px;border-radius:50%;object-fit:cover">@User.Identity.Name.FirstOrDefault()</div>
                            }
                            else
                            {
                                <img src="@User.FindFirst("ImageLink")?.Value"
                                     style="width:34px;height:34px;border-radius:50%;object-fit:cover;" alt="User">
                            }
                            <span style="font-size:.84rem;font-weight:600;">@User.Identity.Name</span>
                            <i class="bi bi-chevron-down" style="font-size:.7rem;"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="border-radius:var(--radius);font-size:.84rem;">
                            <li><a class="dropdown-item" href="/User/Profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/Auth/LogOut" id="logout-btn"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <!-- Desktop Nav -->
                <div class="d-none d-lg-flex align-items-center gap-1">
                    <a href="/Home/Index" class="nav-link @IsActive("Home", "Index")">Home</a>
                    <a href="/Home/About" class="nav-link @IsActive("Home", "About")">About</a>
                    <a href="/Home/Contact" class="nav-link @IsActive("Home", "Contact")">Contact</a>
                </div>
                <div class="d-none d-lg-flex align-items-center gap-2 ms-3">
                    <a href="/Auth/LoginPage" class="btn-nav-login">Log In</a>
                    <a href="/Auth/RegisterPage" class="btn-nav-register">Register</a>
                </div>
            }

            <!-- Mobile toggle -->
            <button class="btn d-lg-none border-0 p-0" data-bs-toggle="collapse" data-bs-target="#mobileNav">
                <i class="bi bi-list fs-4 text-secondary"></i>
            </button>
        </div>
    </nav>

    <!-- Mobile Nav (moved OUTSIDE <nav>, so it's not a flex item of .ocms-navbar) -->
    <div class="collapse" id="mobileNav">
        <div class="container pb-3 pt-1 d-flex flex-column gap-1">
            @if (User.Identity!.IsAuthenticated)
            {
                <a href="/Home/Index" class="nav-link @IsActive("Home", "Index")">Home</a>
                <a href="/Complaint/Submit" class="nav-link @IsActive("Complaint", "Submit")">Submit</a>
                <a href="/Complaint/Track" class="nav-link @IsActive("Complaint", "Track")">Track</a>
                <a href="/User/Profile" class="nav-link">My Profile</a>
                <a href="/Auth/LogOut" class="nav-link text-danger">Sign Out</a>
            }
            else
            {
                <a href="/Home/Index" class="nav-link @IsActive("Home", "Index")">Home</a>
                <a href="/Home/About" class="nav-link @IsActive("Home", "About")">About</a>
                <a href="/Home/Contact" class="nav-link @IsActive("Home", "Contact")">Contact</a>
                <div class="d-flex gap-2 mt-2">
                    <a href="/Auth/LoginPage" class="btn-nav-login">Log In</a>
                    <a href="/Auth/RegisterPage" class="btn-nav-register">Register</a>
                </div>
            }
        </div>
    </div>

    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ═══ Footer ════════════════════════════════════════════════ -->
    <footer class="ocms-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="footer-brand"><i class="bi bi-shield-check me-1"></i> OCMS</div>
                    <p class="footer-desc">Online Complaint Management System — helping citizens file and resolve complaints with full transparency.</p>
                    <div class="social-links">
                        <a href="#" class="social-btn"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="social-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-btn"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-btn"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Quick Links</h6>
                    <ul>
                        <li><a href="/Home/Index">Home</a></li>
                        <li><a href="/Home/About">About</a></li>
                        <li><a href="/Home/Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Services</h6>
                    <ul>
                        <li><a href="/Complaint/Submit">Submit Complaint</a></li>
                        <li><a href="/Complaint/Track">Track Complaint</a></li>
                        <li><a href="/User/Profile">My Profile</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6>Contact Info</h6>
                    <ul>
                        <li><a href="mailto:support@ocms.com"><i class="bi bi-envelope me-2"></i>support@ocms.com</a></li>
                        <li><a href="tel:+923001234567"><i class="bi bi-telephone me-2"></i>+92 300 123 4567</a></li>
                        <li><a href="#"><i class="bi bi-geo-alt me-2"></i>123 Main Street, Rawalpindi, PK</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2025 OCMS — Online Complaint Management System. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/ajaxHelper.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        /* ─── App Loader ─────────────────────────────────────── */
        const Loader = {
        show() { $('#app-loader').removeClass('hide'); },
        hide() { $('#app-loader').addClass('hide'); }
        };

        $(function () {
        setTimeout(() => Loader.hide(), 400);
        });
    </script>
    <script>
        /* ─── Form Helpers ────────────────────────────────────── */
        const Form = {
        clearErrors($form) {
        $form.find('.is-invalid').removeClass('is-invalid');
        $form.find('.ocms-error-msg').text('');
        },
        setError($input, msg) {
        $input.addClass('is-invalid');
        $input.siblings('.ocms-error-msg').text(msg);
        },
        validate($form) {
        this.clearErrors($form);
        let valid = true;
        $form.find('[required]').each(function () {
        const $f = $(this);
        if (!$f.val().trim()) {
        Form.setError($f, 'This field is required.');
        valid = false;
        }
        });
        return valid;
        }
        };
    </script>

</body>
</html>