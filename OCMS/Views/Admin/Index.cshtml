@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <h4>Dashboard</h4>
    <p>Welcome back, Admin. Here's what's happening today.</p>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card" style="--stat-color:#dbeafe;--stat-icon-color:#1a56db;">
            <div class="stat-icon"><i class="bi bi-clipboard2-list"></i></div>
            <div id="total-complaints" class="stat-val">248</div>
            <div class="stat-lbl">Total Complaints</div>
            <div class="stat-diff up"><i class="bi bi-arrow-up"></i> +12 this week</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card" style="--stat-color:#fef3c7;--stat-icon-color:#d97706;">
            <div class="stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div id="pending-complaints" class="stat-val">42</div>
            <div class="stat-lbl">Pending</div>
            <div class="stat-diff down"><i class="bi bi-arrow-down"></i> -3 from yesterday</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card" style="--stat-color:#dcfce7;--stat-icon-color:#16a34a;">
            <div class="stat-icon"><i class="bi bi-patch-check"></i></div>
            <div id="resolved-complaints" class="stat-val">189</div>
            <div class="stat-lbl">Resolved</div>
            <div class="stat-diff up"><i class="bi bi-arrow-up"></i> +8 today</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="admin-stat-card" style="--stat-color:#f3e8ff;--stat-icon-color:#7c3aed;">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div id="total-users" class="stat-val">1,204</div>
            <div class="stat-lbl">Total Users</div>
            <div class="stat-diff up"><i class="bi bi-arrow-up"></i> +24 this month</div>
        </div>
    </div>
</div>

<!-- Recent Complaints -->
<div class="admin-card">
    <div class="admin-card-header">
        <h6 class="mb-0">Recent Complaints</h6>
        <a href="@Url.Action("Complaints", "Admin")" class="ms-auto btn-outline-ocms" style="font-size:.78rem;padding:5px 14px;">View All</a>
    </div>
    <div class="table-responsive">
        <table class="ocms-table">
            <thead>
                <tr><th>#ID</th><th>User</th><th>Title</th><th>Category</th><th>Date</th><th>Status</th></tr>
            </thead>
            <tbody id="recent-complaints-body">
                <tr><td colspan="6" class="text-center py-4"><i class="bi bi-arrow-repeat"></i></td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            LoadDashBoard();
            LoadRecentComplaints();
        });

        function LoadDashBoard() {
            OCMS.ajax({
                url: '/Admin/GetStats',
                method: 'GET',
                toastSuccess: false,
                onSuccess(data) {
                    $('#total-complaints').text(data.totalComplaints);
                    $('#pending-complaints').text(data.pendingComplaints);
                    $('#resolved-complaints').text(data.resolvedComplaints);
                    $('#total-users').text(data.totalUsers);
                }
            });
        }

        function LoadRecentComplaints() {
            OCMS.ajax({
                url: '/Complaint/GetFiltered?page=1&pageSize=5',
                method: 'GET',
                toastSuccess: false,
                onSuccess(data) {
                    const items = data.items || [];
                    if (!items.length) {
                        $('#recent-complaints-body').html('<tr><td colspan="6" class="text-center text-muted py-4">No complaints yet.</td></tr>');
                        return;
                    }
                    const labels = { 0: ['Pending', 'badge-pending'], 1: ['In Progress', 'badge-progress'], 2: ['Resolved', 'badge-resolved'], 3: ['Rejected', 'badge-rejected'] };
                    const rows = items.map(c => {
                        const [text, cls] = labels[c.status] || ['Unknown', ''];
                        return `
                            <tr>
                                <td class="fw-600">${c.trackId}</td>
                                <td>${c.submittedBy}</td>
                                <td>${c.title}</td>
                                <td>${c.categoryName}</td>
                                <td>${new Date(c.submissionDate).toLocaleDateString('en-GB')}</td>
                                <td><span class="badge-ocms ${cls}">${text}</span></td>
                            </tr>`;
                    }).join('');
                    $('#recent-complaints-body').html(rows);
                }
            });
        }

    </script>
}