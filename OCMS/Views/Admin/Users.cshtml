@{
    ViewData["Title"] = "Users Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <h4>User Management</h4>
        <p>View, create, edit, and manage all registered users.</p>
    </div>
    <button class="btn-primary-ocms" id="add-user-btn">
        <i class="bi bi-person-plus"></i> Add User
    </button>
</div>

<!-- User Stats -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#dbeafe;--stat-icon-color:#1a56db;">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div id="statTotal" class="stat-val">1,204</div>
            <div class="stat-lbl">Total Users</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#dcfce7;--stat-icon-color:#16a34a;">
            <div class="stat-icon"><i class="bi bi-person-check"></i></div>
            <div id="statActive" class="stat-val">1,180</div>
            <div class="stat-lbl">Active</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#fee2e2;--stat-icon-color:#dc2626;">
            <div class="stat-icon"><i class="bi bi-person-x"></i></div>
            <div id="statInactive" class="stat-val">24</div>
            <div class="stat-lbl">Blocked</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#f3e8ff;--stat-icon-color:#7c3aed;">
            <div class="stat-icon"><i class="bi bi-shield-check"></i></div>
            <div id="statAdmins" class="stat-val">3</div>
            <div class="stat-lbl">Admins</div>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="admin-card">
    <div class="admin-card-header">
        <h6 class="mb-0">All Users</h6>
        <div class="ms-auto d-flex gap-2 align-items-center">
            <select onchange="OnUserRoleChange()" class="form-select form-select-sm" id="role-filter" style="width:120px;font-size:.78rem;">
                <option value="">All Roles</option>
                <option value="0">User</option>
                <option value="1">Admin</option>
                <option value="2">Operator</option>
            </select>
            <select class="form-select form-select-sm" id="status-filter-users" style="width:130px;font-size:.78rem;">
                <option value="">All Status</option>
                <option value="0">Active</option>
                <option value="1">InActive</option>
                <option value="2">Blocked</option>
            </select>
        </div>
    </div>
    <div class="table-responsive">
        <table class="ocms-table" id="users-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th>Email</th>
                    @* <th>Phone</th> *@
                    <th>Role</th>
                    <th>Complaints</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="users-table-body">
                <tr data-role="user" data-status="active">
                    <td>1</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=1" style="width:32px;height:32px;border-radius:50%;" alt=""><div><div class="fw-600" style="font-size:.86rem;">Sarah Johnson</div></div></div></td>
                    <td>sarah@example.com</td>
                    <td>+1 234 567 890</td>
                    <td><span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span></td>
                    <td>3</td>
                    <td>Jan 01, 2025</td>
                    <td><span class="badge-ocms badge-resolved">Active</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="1" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn danger btn-toggle-user" data-id="1" data-action="block" title="Block"><i class="bi bi-slash-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="1" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <tr data-role="user" data-status="active">
                    <td>2</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=3" style="width:32px;height:32px;border-radius:50%;" alt=""><div><div class="fw-600" style="font-size:.86rem;">Ahmed Khan</div></div></div></td>
                    <td>ahmed@example.com</td>
                    <td>+92 300 111 2222</td>
                    <td><span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span></td>
                    <td>7</td>
                    <td>Dec 15, 2024</td>
                    <td><span class="badge-ocms badge-resolved">Active</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="2" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn danger btn-toggle-user" data-id="2" data-action="block" title="Block"><i class="bi bi-slash-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="2" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <tr data-role="admin" data-status="active">
                    <td>3</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=5" style="width:32px;height:32px;border-radius:50%;" alt=""><div><div class="fw-600" style="font-size:.86rem;">Maria Lopez</div></div></div></td>
                    <td>maria@ocms.com</td>
                    <td>+1 555 888 9999</td>
                    <td><span class="badge-ocms" style="background:#f3e8ff;color:#6d28d9;">Admin</span></td>
                    <td>0</td>
                    <td>Nov 20, 2024</td>
                    <td><span class="badge-ocms badge-resolved">Active</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="3" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn" style="opacity:.4;cursor:not-allowed;" title="Can't block admin"><i class="bi bi-slash-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="3" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <tr data-role="user" data-status="blocked">
                    <td>4</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=7" style="width:32px;height:32px;border-radius:50%;filter:grayscale(1);" alt=""><div><div class="fw-600" style="font-size:.86rem;">David Lee</div></div></div></td>
                    <td>david@example.com</td>
                    <td>+1 999 000 1111</td>
                    <td><span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span></td>
                    <td>1</td>
                    <td>Oct 10, 2024</td>
                    <td><span class="badge-ocms badge-rejected">Blocked</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="4" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn btn-toggle-user" data-id="4" data-action="unblock" title="Unblock" style="color:var(--success)"><i class="bi bi-check-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="4" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="admin-card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
        <small class="text-muted">Showing 1–4 of 1,204 users</small>
        <nav>
            <ul class="pagination pagination-sm mb-0" style="gap:4px;">
                <li class="page-item disabled"><a class="page-link" style="border-radius:6px;">&laquo;</a></li>
                <li class="page-item active"><a class="page-link" style="border-radius:6px;background:var(--primary);border-color:var(--primary);">1</a></li>
                <li class="page-item"><a class="page-link" style="border-radius:6px;">2</a></li>
                <li class="page-item"><a class="page-link" style="border-radius:6px;">3</a></li>
                <li class="page-item"><a class="page-link" style="border-radius:6px;">&raquo;</a></li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        // ===== STATE =====
        let allUsers    = [];
        let filtered    = [];
        let currentPage = 1;
        const pageSize  = 10;

        // ===== INIT =====
        $(document).ready(function () {
            LoadUsers();
        });

        // ===== LOAD =====
        function LoadUsers() {
            $.get('/User/GetAll', function (response) {
                if (!response.success) {
                    showAdminToast('Failed to load users.', 'danger');
                    return;
                }

                allUsers = response.data;
                filtered = [...allUsers];

                // Stats
                document.getElementById('statTotal').innerText    = allUsers.length;
                document.getElementById('statActive').innerText   =
                    allUsers.filter(u => u.status === 0).length;
                document.getElementById('statInactive').innerText =
                    allUsers.filter(u => u.status === 1).length;
                document.getElementById('statAdmins').innerText   =
                    allUsers.filter(u => u.role === 1).length;

                RenderTable();
            });
        }

        // ===== FILTER =====
        function FilterTable() {
            const search = $('#searchInput').val().toLowerCase();
            const status = $('#status-filter-users').val();
            const role   = $('#role-filter').val();

            filtered = allUsers.filter(u => {
                const matchSearch = !search ||
                    u.fullName.toLowerCase().includes(search) ||
                    u.email.toLowerCase().includes(search);

                const matchStatus = status === '' ||
                    u.status.toString() === status;

                const matchRole = role === '' ||
                    u.role.toString() === role;

                return matchSearch && matchStatus && matchRole;
            });

            currentPage = 1;
            RenderTable();
        }

        function ResetFilters() {
            $('#searchInput').val('');
            $('#status-filter-users').val('');
            $('#role-filter').val('');
            filtered = [...allUsers];
            currentPage = 1;
            RenderTable();
        }

        // ===== RENDER TABLE =====
        function RenderTable() {
            const totalPages = Math.ceil(filtered.length / pageSize) || 1;
            const start      = (currentPage - 1) * pageSize;
            const paged      = filtered.slice(start, start + pageSize);

            $('#rowCount').text(filtered.length);
            $('#currentPage').text(currentPage);
            $('#totalPages').text(totalPages);
            $('#prevBtn').prop('disabled', currentPage === 1);
            $('#nextBtn').prop('disabled', currentPage >= totalPages);

            if (!paged.length) {
                $('#users-table-body').html(`
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                            No users found.
                        </td>
                    </tr>`);
                return;
            }

                      const rows = paged.map((u, index) => {

            //  correct serial with pagination
            const i = (currentPage - 1) * pageSize + index + 1;

            //  avatar
            const avatar = u.imageLink
                ? `<img src="${u.imageLink}"
                        style="width:32px;height:32px;border-radius:50%;object-fit:cover;">`
                : `<img src="https://ui-avatars.com/api/?name=${encodeURIComponent(u.fullName)}&background=6366f1&color=fff&size=32"
                        style="width:32px;height:32px;border-radius:50%;">`;

            //  role
            const roleBadge = u.role === 1
                ? `<span class="badge-ocms" style="background:#f3e8ff;color:#6d28d9;">Admin</span>`
                : `<span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span>`;

            //  status
            const statusBadge = u.status === 0
                ? `<span class="badge-ocms badge-resolved">Active</span>`
                : `<span class="badge-ocms badge-rejected">Blocked</span>`;

            return `
                <tr data-id="${u.userId}"
                    data-role="${u.role === 1 ? 'admin' : 'user'}"
                    data-status="${u.status === 0 ? 'active' : 'blocked'}">

                    <!-- # -->
                    <td>${i}</td>

                    <!-- User (avatar + name SAME column like static) -->
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            ${avatar}
                            <div>
                                <div class="fw-600" style="font-size:.86rem;">
                                    ${u.fullName}
                                </div>
                            </div>
                        </div>
                    </td>

                    <!-- Email -->
                    <td>${u.email}</td>

                    <!-- Role -->
                    <td>${roleBadge}</td>

                    <!-- Complaints -->
                    <td>${u.totalComplaints}</td>

                    <!-- Status -->
                    <td>${statusBadge}</td>

                    <!-- Joined -->
                    <td>
                        ${new Date(u.createdDate).toLocaleDateString('en-GB')}
                    </td>

                    <!-- Actions -->
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user"
                                    onclick="ViewUser('${u.userId}')"
                                    title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>

                            ${
                                u.role === 1
                                ? `<button class="action-btn"
                                        style="opacity:.4;cursor:not-allowed;"
                                        title="Can't block admin">
                                        <i class="bi bi-slash-circle"></i>
                                   </button>`
                                : `<button class="action-btn btn-toggle-user"
                                        onclick="ToggleStatus('${u.userId}', this)"
                                        title="${u.status === 0 ? 'Block' : 'Unblock'}"
                                        style="color:${u.status === 0 ? '' : 'var(--success)'}">
                                        <i class="bi ${
                                            u.status === 0 ? 'bi-slash-circle' : 'bi-check-circle'
                                        }"></i>
                                   </button>`
                            }

                            <button id="btn-delete-user" data-id="${u.userId}" class="action-btn danger btn-delete-user"
                                    
                                    title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        }).join('');

            $('#users-table-body').html(rows);
            // AnimateRows();
        }

        // ===== PAGINATION =====
        function ChangePage(direction) {
            const totalPages = Math.ceil(filtered.length / pageSize);
            currentPage = Math.max(1,
                Math.min(currentPage + direction, totalPages));
            RenderTable();
        }

        // ===== VIEW USER =====
        function ViewUser(id) {
            const modal = new bootstrap.Modal(
                document.getElementById('userDetailModal'));
            modal.show();

            $('#userDetailBody').html(
                '<div class="text-center py-4">' +
                '<i class="fas fa-spinner fa-spin fa-lg"></i></div>');

            $.get(`/AdminUser/GetById?id=${id}`, function (response) {
                if (!response.success) {
                    $('#userDetailBody').html(
                        '<p class="text-danger text-center">Failed to load.</p>');
                    return;
                }

                const u = response.data;
                const avatar = u.imageLink
                    ? `<img src="${u.imageLink}"
                            class="rounded-circle mb-3"
                            style="width:80px;height:80px;object-fit:cover;
                                   border:3px solid var(--admin-primary);">`
                    : `<img src="https://ui-avatars.com/api/?name=${encodeURIComponent(u.fullName)}&background=6366f1&color=fff&size=80"
                            class="rounded-circle mb-3"
                            style="width:80px;height:80px;">`;

                $('#userDetailBody').html(`
                    <div class="text-center mb-4">
                        ${avatar}
                        <h6 class="mb-1">${u.fullName}</h6>
                        <small class="text-muted">${u.email}</small>
                    </div>
                    <div class="row g-3">
                        <div class="col-6">
                            <small class="text-muted d-block">Role</small>
                            <strong>${u.role === 1 ? 'Admin' : 'User'}</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Status</small>
                            <strong>${u.status === 0 ? 'Active' : 'Inactive'}</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Joined</small>
                            <strong>
                                ${new Date(u.createdDate)
                                    .toLocaleDateString('en-GB')}
                            </strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Last Login</small>
                            <strong>
                                ${u.lastLoginDate
                                    ? new Date(u.lastLoginDate)
                                        .toLocaleDateString('en-GB')
                                    : 'Never'}
                            </strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Total Complaints</small>
                            <strong>${u.totalComplaints}</strong>
                        </div>
                    </div>`);
            });
        }

        // ===== TOGGLE STATUS =====
        function ToggleStatus(id, btn) {
            $.ajax({
                url: `/AdminUser/ToggleStatus?id=${id}`,
                type: 'PUT',
                success: function (response) {
                    if (!response.success) {
                        showAdminToast(response.message, 'danger');
                        return;
                    }

                    showAdminToast(response.message, 'success');

                    // Local data update
                    const u = allUsers.find(x => x.userId === id);
                    if (u) {
                        u.status = u.status === 0 ? 1 : 0;
                        RenderTable();
                    }
                }
            });
        }

        // ===== DELETE =====
        // function DeleteUser(id) {
        //     OCMS.Confirm.show(
        //         'Are you sure you want to delete this user? ' +
        //         'All their complaints will also be deleted.',
        //         function () {
        //             $.ajax({
        //                 url: `/AdminUser/Delete?id=${id}`,
        //                 type: 'DELETE',
        //                 success: function (response) {
        //                     if (!response.success) {
        //                         showAdminToast(response.message, 'danger');
        //                         return;
        //                     }
        //                     showAdminToast('User deleted successfully.', 'success');
        //                     allUsers = allUsers.filter(u => u.userId !== id);
        //                     filtered = filtered.filter(u => u.userId !== id);

        //                     Stats update
        //                     document.getElementById('statTotal').innerText =
        //                         allUsers.length;
        //                     document.getElementById('statActive').innerText =
        //                         allUsers.filter(u => u.status === 0).length;
        //                     document.getElementById('statInactive').innerText =
        //                         allUsers.filter(u => u.status === 1).length;

        //                     RenderTable();
        //                 }
        //             });
        //         }
        //     );
        // }

        $(document).on('click','.btn-delete-user',async function (){
        
            const $btn = $(this);
            const id = $btn.data('id');

          const confirmed= await  OCMS.Confirm.show(
                {
                    title:'Delete User',
                    text:  'Are you sure you want to delete this user? ' +
                           'All their complaints will also be deleted.',
                    icon: '⚠️',
                    ConfirmText: 'Yes,Delete',
                    type: 'danger'
                });
        if(!confirmed) return;
                            
        $.ajax({
                url: `/User/Delete?id=${id}`,
                type: 'DELETE',
                success: function (response) {
                    if (!response.success) {
                        Toast.error('Error',response.message);
                        return;
                    }
                    Toast.success('Success','User deleted successfully.');
                    allUsers = allUsers.filter(u => u.userId !== id);
                    filtered = filtered.filter(u => u.userId !== id);

                    // Stats update
                    document.getElementById('statTotal').innerText =
                        allUsers.length;
                    document.getElementById('statActive').innerText =
                        allUsers.filter(u => u.status === 0).length;
                    document.getElementById('statInactive').innerText =
                        allUsers.filter(u => u.status === 1).length;

                    RenderTable();
                }
            });
        });

        function OnUserRoleChange(){
            const value = $(this).val;

            $.ajax({
                url: '@Url.Action("GetUserByRole", "User")',
                type: 'get',
                success:function(response){
                    if(!response.Success)
                    Toast.error('Error',response.message);
                    filtered=response.data;
                    RenderTable();
                }

            });

        }
    </script>
}


                                

