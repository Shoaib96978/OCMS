@{
    ViewData["Title"] = "Users Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <h4>User Management</h4>
        <p>View, create, edit, and manage all registered users.</p>
    </div>
    <button class="btn-primary-ocms" id="add-user-btn" data-bs-toggle="modal" data-bs-target="#add-user-modal">
        <i class="bi bi-person-plus"></i> Add User
    </button>
</div>

<!-- User Stats -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#dbeafe;--stat-icon-color:#1a56db;">
            <div class="stat-icon"><i class="bi bi-people"></i></div>
            <div id="statTotal" class="stat-val">1,204</div>
            <div class="stat-lbl">Total Users</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#dcfce7;--stat-icon-color:#16a34a;">
            <div class="stat-icon"><i class="bi bi-person-check"></i></div>
            <div id="statActive" class="stat-val">1,180</div>
            <div class="stat-lbl">Active</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#fee2e2;--stat-icon-color:#dc2626;">
            <div class="stat-icon"><i class="bi bi-person-x"></i></div>
            <div id="statInactive" class="stat-val">24</div>
            <div class="stat-lbl">Blocked</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="admin-stat-card" style="--stat-color:#f3e8ff;--stat-icon-color:#7c3aed;">
            <div class="stat-icon"><i class="bi bi-shield-check"></i></div>
            <div id="statAdmins" class="stat-val">3</div>
            <div class="stat-lbl">Admins</div>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="admin-card">
    <div class="admin-card-header">
        <h6 class="mb-0">All Users</h6>
        <div class="ms-auto d-flex gap-2 align-items-center flex-wrap">
            <input type="text" id="search-input" class="ocms-input" style="width:180px;font-size:.8rem;padding:6px 12px;" placeholder="Name or email...">
            <select class="form-select form-select-sm" id="role-filter" style="width:120px;font-size:.78rem;">
                <option value="">All Roles</option>
                <option value="0">User</option>
                <option value="1">Admin</option>
            </select>
            <select class="form-select form-select-sm" id="status-filter-users" style="width:130px;font-size:.78rem;">
                <option value="">All Status</option>
                <option value="0">Active</option>
                <option value="1">Inactive</option>
                <option value="2">Blocked</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary" id="clear-user-filters" style="font-size:.78rem;">Clear</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="ocms-table" id="users-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>User</th>
                    <th>Email</th>
                    @* <th>Phone</th> *@
                    <th>Role</th>
                    <th>Complaints</th>
                    <th>Status</th>
                    <th>Joined</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="users-table-body">
                <tr data-role="user" data-status="active">
                    <td>1</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=1" style="width:32px;height:32px;border-radius:50%;" alt=""><div><div class="fw-600" style="font-size:.86rem;">Sarah Johnson</div></div></div></td>
                    <td>sarah@example.com</td>
                    <td>+1 234 567 890</td>
                    <td><span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span></td>
                    <td>3</td>
                    <td>Jan 01, 2025</td>
                    <td><span class="badge-ocms badge-resolved">Active</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="1" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn danger btn-toggle-user" data-id="1" data-action="block" title="Block"><i class="bi bi-slash-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="1" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <tr data-role="user" data-status="active">
                    <td>2</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=3" style="width:32px;height:32px;border-radius:50%;" alt=""><div><div class="fw-600" style="font-size:.86rem;">Ahmed Khan</div></div></div></td>
                    <td>ahmed@example.com</td>
                    <td>+92 300 111 2222</td>
                    <td><span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span></td>
                    <td>7</td>
                    <td>Dec 15, 2024</td>
                    <td><span class="badge-ocms badge-resolved">Active</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="2" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn danger btn-toggle-user" data-id="2" data-action="block" title="Block"><i class="bi bi-slash-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="2" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <tr data-role="admin" data-status="active">
                    <td>3</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=5" style="width:32px;height:32px;border-radius:50%;" alt=""><div><div class="fw-600" style="font-size:.86rem;">Maria Lopez</div></div></div></td>
                    <td>maria@ocms.com</td>
                    <td>+1 555 888 9999</td>
                    <td><span class="badge-ocms" style="background:#f3e8ff;color:#6d28d9;">Admin</span></td>
                    <td>0</td>
                    <td>Nov 20, 2024</td>
                    <td><span class="badge-ocms badge-resolved">Active</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="3" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn" style="opacity:.4;cursor:not-allowed;" title="Can't block admin"><i class="bi bi-slash-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="3" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <tr data-role="user" data-status="blocked">
                    <td>4</td>
                    <td><div class="d-flex align-items-center gap-2"><img src="https://i.pravatar.cc/40?img=7" style="width:32px;height:32px;border-radius:50%;filter:grayscale(1);" alt=""><div><div class="fw-600" style="font-size:.86rem;">David Lee</div></div></div></td>
                    <td>david@example.com</td>
                    <td>+1 999 000 1111</td>
                    <td><span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span></td>
                    <td>1</td>
                    <td>Oct 10, 2024</td>
                    <td><span class="badge-ocms badge-rejected">Blocked</span></td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="action-btn btn-edit-user" data-id="4" title="Edit"><i class="bi bi-pencil"></i></button>
                            <button class="action-btn btn-toggle-user" data-id="4" data-action="unblock" title="Unblock" style="color:var(--success)"><i class="bi bi-check-circle"></i></button>
                            <button class="action-btn danger btn-delete-user" data-id="4" title="Delete"><i class="bi bi-trash"></i></button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="admin-card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
        <small class="text-muted">Showing 1–4 of 1,204 users</small>
        <nav>
            <ul class="pagination pagination-sm mb-0" style="gap:4px;">
                <li class="page-item disabled"><a class="page-link" style="border-radius:6px;">&laquo;</a></li>
                <li class="page-item active"><a class="page-link" style="border-radius:6px;background:var(--primary);border-color:var(--primary);">1</a></li>
                <li class="page-item"><a class="page-link" style="border-radius:6px;">2</a></li>
                <li class="page-item"><a class="page-link" style="border-radius:6px;">3</a></li>
                <li class="page-item"><a class="page-link" style="border-radius:6px;">&raquo;</a></li>
            </ul>
        </nav>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="add-user-modal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:var(--radius-lg);border:none;">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-700"><i class="bi bi-person-plus me-2 text-primary"></i>Add New User</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form id="add-user-form" novalidate>
                    <div class="ocms-form-group">
                        <label class="ocms-label">Full Name <span class="req">*</span></label>
                        <input type="text" id="au-fullname" class="ocms-input" required>
                        <span class="ocms-error-msg"></span>
                    </div>
                    <div class="ocms-form-group">
                        <label class="ocms-label">Email Address <span class="req">*</span></label>
                        <input type="email" id="au-email" class="ocms-input" required>
                        <span class="ocms-error-msg"></span>
                    </div>
                    <div class="ocms-form-group">
                        <label class="ocms-label">Password <span class="req">*</span></label>
                        <input type="password" id="au-password" class="ocms-input" required>
                        <span class="ocms-error-msg"></span>
                    </div>
                    <div class="ocms-form-group mb-0">
                        <label class="ocms-label">Role <span class="req">*</span></label>
                        <select id="au-role" class="ocms-select" required>
                            <option value="1">User</option>
                            <option value="0">Admin</option>
                            <option value="2">Operator</option>
                        </select>
                    </div>

                    <div id="admin-password-wrapper" class="ocms-form-group mt-3 d-none">
                        <hr class="my-3">
                        <p class="text-muted mb-2" style="font-size:.8rem;">
                            <i class="bi bi-lock me-1"></i> Confirm your admin password to add an Admin
                        </p>
                        <label class="ocms-label">Your Admin Password <span class="req">*</span></label>
                        <input type="password" id="au-current-admin-password" class="ocms-input">
                        <span class="ocms-error-msg"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn-outline-ocms" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="save-add-user-btn" class="btn-primary-ocms">
                    <i class="bi bi-check2"></i> Save User
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
                // ===== STATE =====
        let currentPage = 1;
        const pageSize = 10;
        let requestToken = 0;

        // ===== INIT =====
              $(document).ready(function () {
            loadStats();
            fetchUsers();
            bindEvents();
        });

        function loadStats() {
            OCMS.ajax({
                url: '/User/GetStats',
                method: 'GET',
                toastSuccess: false,
                toastError: false,
                onSuccess(data) {
                    $('#statTotal').text(data.total);
                    $('#statActive').text(data.active);
                    $('#statInactive').text(data.blocked);   // "Blocked" card
                    $('#statAdmins').text(data.admins);
                }
            });
        }

        // ===== FETCH USERS =====
        function fetchUsers() {
            const myToken = ++requestToken;

            const params = {
                status: $('#status-filter-users').val(),
                role: $('#role-filter').val(),
                search: $('#search-input').val().trim(),
                page: currentPage,
                pageSize: pageSize
            };

            let skeletonRows = '';
            for (let i = 0; i < 5; i++) {
                skeletonRows += `
                    <tr>
                        <td><span class="skeleton skeleton-cell short"></span></td>
                        <td><span class="skeleton skeleton-cell"></span></td>
                        <td><span class="skeleton skeleton-cell"></span></td>
                        <td><span class="skeleton skeleton-cell badge"></span></td>
                        <td><span class="skeleton skeleton-cell short"></span></td>
                        <td><span class="skeleton skeleton-cell badge"></span></td>
                        <td><span class="skeleton skeleton-cell short"></span></td>
                        <td><span class="skeleton skeleton-cell" style="width:80px;"></span></td>
                    </tr>`;
            }
            $('#users-table-body').html(skeletonRows);

            OCMS.ajax({
                url: '/User/GetFiltered?' + $.param(params),
                method: 'GET',
                toastSuccess: false,
                toastError: true,
                onSuccess(data) {
                    if (myToken !== requestToken) return;
                    renderUsersTable(data.items || []);
                    renderUserPagination(data.totalCount, data.totalPages);
                    updateStats(data.items || [], data.totalCount);
                }
            });
        }

        // ===== RENDER TABLE =====
        function renderUsersTable(items) {
            if (!items.length) {
                $('#users-table-body').html(`
                    <tr><td colspan="8" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>No users found.
                    </td></tr>`);
                return;
            }

            const start = (currentPage - 1) * pageSize;

            const rows = items.map((u, index) => {
                const i = start + index + 1;

                const avatar = u.imageLink
                    ? `<img src="${u.imageLink}" style="width:32px;height:32px;border-radius:50%;object-fit:cover;">`
                    : `<img src="https://ui-avatars.com/api/?name=${encodeURIComponent(u.fullName)}&background=6366f1&color=fff&size=32" style="width:32px;height:32px;border-radius:50%;">`;

                const roleBadge = u.role === 1
                    ? `<span class="badge-ocms" style="background:#f3e8ff;color:#6d28d9;">Admin</span>`
                    : `<span class="badge-ocms" style="background:#dbeafe;color:#1e40af;">User</span>`;

                return `
                    <tr data-id="${u.userId}">
                        <td>${i}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                ${avatar}
                                <div class="fw-600" style="font-size:.86rem;">${u.fullName}</div>
                            </div>
                        </td>
                        <td>${u.email}</td>
                        <td>${roleBadge}</td>
                        <td>${u.totalComplaints}</td>
                        <td>
                            <select class="form-select form-select-sm status-inline-user" data-id="${u.userId}" style="width:110px;font-size:.75rem;">
                                <option value="0" ${u.status === 0 ? 'selected' : ''}>Active</option>
                                <option value="1" ${u.status === 1 ? 'selected' : ''}>Inactive</option>
                                <option value="2" ${u.status === 2 ? 'selected' : ''}>Blocked</option>
                            </select>
                        </td>
                        <td>${new Date(u.createdDate).toLocaleDateString('en-GB')}</td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="action-btn btn-view-user" data-id="${u.userId}" title="View"><i class="bi bi-eye"></i></button>
                                <button class="action-btn btn-save-user-status" data-id="${u.userId}" title="Save Status"><i class="bi bi-check2"></i></button>
                                ${u.role === 1
                                    ? `<button class="action-btn" style="opacity:.4;cursor:not-allowed;" title="Can't delete admin"><i class="bi bi-trash"></i></button>`
                                    : `<button class="action-btn danger btn-delete-user" data-id="${u.userId}" title="Delete"><i class="bi bi-trash"></i></button>`}
                            </div>
                        </td>
                    </tr>`;
            }).join('');

            $('#users-table-body').html(rows);
        }

        // ===== STATS (from current page's data — for exact global totals a separate /User/GetStats endpoint would be better) =====
        function updateStats(items, totalCount) {
            $('#statTotal').text(totalCount);
        }

        // ===== PAGINATION =====
        function renderUserPagination(total, totalPages) {
            $('#user-pagination-info').text(`Showing ${total === 0 ? 0 : (currentPage - 1) * pageSize + 1}–${Math.min(currentPage * pageSize, total)} of ${total} users`);

            let html = `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage - 1}" style="border-radius:6px;">&laquo;</a></li>`;

            for (let i = 1; i <= totalPages; i++) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                    <a class="page-link" href="#" data-page="${i}" style="border-radius:6px;${i === currentPage ? 'background:var(--primary);border-color:var(--primary);' : ''}">${i}</a></li>`;
            }

            html += `<li class="page-item ${currentPage === totalPages || totalPages === 0 ? 'disabled' : ''}">
                <a class="page-link" href="#" data-page="${currentPage + 1}" style="border-radius:6px;">&raquo;</a></li>`;

            $('#user-pagination-controls').html(html);
        }

        // ===== EVENTS =====
        function bindEvents() {

            $('#status-filter-users').on('change', function () { currentPage = 1; fetchUsers(); });
            $('#role-filter').on('change', function () { currentPage = 1; fetchUsers(); });

            let searchTimer;
            $('#search-input').on('input', function () {
                clearTimeout(searchTimer);
                const val = $(this).val().trim();
                if (val.length > 0 && val.length < 2) return;
                searchTimer = setTimeout(() => { currentPage = 1; fetchUsers(); }, 400);
            });

            $('#clear-user-filters').on('click', function () {
                const hasActive = $('#status-filter-users').val() !== '' || $('#role-filter').val() !== '' || $('#search-input').val().trim() !== '';
                if (!hasActive) return;
                $('#status-filter-users, #role-filter').val('');
                $('#search-input').val('');
                currentPage = 1;
                fetchUsers();
            });

            $(document).on('click', '#user-pagination-controls .page-link', function (e) {
                e.preventDefault();
                const page = parseInt($(this).data('page'));
                if (page < 1) return;
                currentPage = page;
                fetchUsers();
            });

                           // Role select change → admin password field toggle
        $('#au-role').on('change', function () {
            if ($(this).val() === '0') {
                $('#admin-password-wrapper').removeClass('d-none');
            } else {
                $('#admin-password-wrapper').addClass('d-none');
                $('#au-current-admin-password').val('').removeClass('is-invalid');
            }
        });

        $('#save-add-user-btn').on('click', function () {
            const fullName = $('#au-fullname').val().trim();
            const email = $('#au-email').val().trim();
            const password = $('#au-password').val();
            const role = $('#au-role').val();
            const currentAdminPassword = $('#au-current-admin-password').val();

            let valid = true;
            $('#add-user-form .ocms-error-msg').text('');
            $('#add-user-form .ocms-input').removeClass('is-invalid');

            if (!fullName) { $('#au-fullname').addClass('is-invalid').siblings('.ocms-error-msg').text('Full name is required.'); valid = false; }
            if (!email) { $('#au-email').addClass('is-invalid').siblings('.ocms-error-msg').text('Email is required.'); valid = false; }
            if (!password || password.length < 6) { $('#au-password').addClass('is-invalid').siblings('.ocms-error-msg').text('Minimum 6 characters.'); valid = false; }
            if (role === '0' && !currentAdminPassword) {
                $('#au-current-admin-password').addClass('is-invalid').siblings('.ocms-error-msg').text('Admin password is required.');
                valid = false;
            }

            if (!valid) return;

            const data = {
                FullName: fullName,
                Email: email,
                Password: password,
                Role: parseInt(role),
                CurrentAdminPassword: role === '0' ? currentAdminPassword : null
            };

            OCMS.ajax({
                url: '/Auth/AddUser',
                method: 'POST',
                data,
                $btn: $(this),
                onSuccess() {
                    $('#add-user-modal').modal('hide');
                    $('#add-user-form')[0].reset();
                    $('#admin-password-wrapper').addClass('d-none');
                    fetchUsers();
                    loadStats();
                }
            });
        });
        // Modal band hone par form reset (agar cancel kiya ho)
               $('#add-user-modal').on('hidden.bs.modal', function () {
            $('#add-user-form')[0].reset();
            $('#add-user-form .is-invalid').removeClass('is-invalid');
            $('#add-user-form .ocms-error-msg').text('');
            $('#admin-password-wrapper').addClass('d-none');
        });

            // View detail
            $(document).on('click', '.btn-view-user', function () {
                const id = $(this).data('id');
                const modal = new bootstrap.Modal(document.getElementById('userDetailModal'));
                modal.show();
                $('#userDetailBody').html('<div class="text-center py-4"><i class="bi bi-arrow-repeat fs-4"></i></div>');

                OCMS.ajax({
                    url: `/User/GetById?id=${id}`,
                    method: 'GET',
                    toastSuccess: false,
                    toastError: true,
                    onSuccess(u) {
                        const avatar = u.imageLink
                            ? `<img src="${u.imageLink}" class="rounded-circle mb-3" style="width:80px;height:80px;object-fit:cover;">`
                            : `<img src="https://ui-avatars.com/api/?name=${encodeURIComponent(u.fullName)}&background=6366f1&color=fff&size=80" class="rounded-circle mb-3" style="width:80px;height:80px;">`;

                        $('#userDetailBody').html(`
                            <div class="text-center mb-4">
                                ${avatar}
                                <h6 class="mb-1">${u.fullName}</h6>
                                <small class="text-muted">${u.email}</small>
                            </div>
                            <div class="row g-3">
                                <div class="col-6"><small class="text-muted d-block">Role</small><strong>${u.role === 1 ? 'Admin' : 'User'}</strong></div>
                                <div class="col-6"><small class="text-muted d-block">Status</small><strong>${['Active', 'Inactive', 'Blocked'][u.status] || 'Unknown'}</strong></div>
                                <div class="col-6"><small class="text-muted d-block">Joined</small><strong>${new Date(u.createdDate).toLocaleDateString('en-GB')}</strong></div>
                                <div class="col-6"><small class="text-muted d-block">Last Login</small><strong>${u.lastLoginDate ? new Date(u.lastLoginDate).toLocaleDateString('en-GB') : 'Never'}</strong></div>
                                <div class="col-6"><small class="text-muted d-block">Total Complaints</small><strong>${u.totalComplaints}</strong></div>
                            </div>`);
                    }
                });
            });

            // Save status
            $(document).on('click', '.btn-save-user-status', async function () {
                const $btn = $(this);
                const id = $btn.data('id');
                const status = $(`.status-inline-user[data-id="${id}"]`).val();

                const confirmed = await OCMS.Confirm.show({
                    title: 'Update Status',
                    text: 'Change this user\'s status?',
                    icon: '🔄',
                    confirmText: 'Yes, Update',
                    type: 'primary'
                });
                if (!confirmed) return;

                OCMS.ajax({
                    url: `/User/UpdateStatus?id=${id}&status=${status}`,
                    method: 'PUT',
                    $btn,
                    onSuccess() { fetchUsers(); loadStats(); }
                });
            });

            // Delete
            $(document).on('click', '.btn-delete-user', async function () {
                const $btn = $(this);
                const id = $btn.data('id');

                const confirmed = await OCMS.Confirm.show({
                    title: 'Delete User',
                    text: 'Are you sure you want to delete this user? All their complaints will also be deleted.',
                    icon: '⚠️',
                    confirmText: 'Yes, Delete',
                    type: 'danger'
                });
                if (!confirmed) return;

                OCMS.ajax({
                    url: `/User/Delete?id=${id}`,
                    method: 'DELETE',
                    $btn,
                    onSuccess() { fetchUsers();loadStats(); }
                });
            });
        }
    </script>
}


                                
